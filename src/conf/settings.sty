% Nastavení šablony — balíčky, styl stránky, nadpisy, barvy, proměnné
\usepackage{fontspec}

% Ligatures=NoCommon: Word ve výchozím stavu nesází ligatury (např. „ti“ v Carlito/Calibri)
\IfFontExistsTF{Calibri}{
  \setmainfont{Calibri}[Ligatures=NoCommon]
}{
  \setmainfont{Carlito}[Ligatures=NoCommon]
}

% Nadpisy jsou v DOCX „tučné Calibri Light“. Calibri Light nemá tučný řez, Word tučnost
% dopočítá — výsledek vypadá zhruba jako běžné Calibri. Proto: s Calibri Light dopočítat
% tučnost (FakeBold), bez něj použít Carlito v běžném řezu s lehce dopočítanou tučností
% (FakeBold=0.3 — hustota tahů změřená proti exportu z Wordu; Carlito Bold je výrazně těžší).
\IfFontExistsTF{Calibri Light}{
  \newfontfamily{\headingfont}{Calibri Light}[Ligatures=NoCommon, BoldFont={Calibri Light}, BoldFeatures={FakeBold=1.5}]
}{
  \newfontfamily{\headingfont}{Carlito}[Ligatures=NoCommon, BoldFont={Carlito}, BoldFeatures={FakeBold=0.3}]
}

