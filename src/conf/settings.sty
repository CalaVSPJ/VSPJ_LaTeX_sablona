% PROMĚNNÉ — zde vyplň údaje o své práci
% Tyto hodnoty se automaticky propíší na titulní stranu
% a do dalších částí dokumentu.
% =========================================================
\newcommand{\varUniversity}{Vysoká škola polytechnická Jihlava}
\newcommand{\varProgram}{Studijní program}              % název studijního programu
\newcommand{\varThesisType}{Bakalářská práce}           % typ práce: Bakalářská práce / Diplomová práce
\newcommand{\varThesisName}{Název práce}                % celý název práce

\newcommand{\varAuthor}{Jméno Příjmení}                 % autor: jméno a příjmení
