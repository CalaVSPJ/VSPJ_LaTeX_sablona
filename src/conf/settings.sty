% =========================================================

% Formatovani nadpisu — velikosti dle DOCX (Nadpis1=18pt, Nadpis2=15pt, Nadpis3=12pt)
\newcommand{\PrvniNadpis}{\fontsize{18}{22}\selectfont}
\newcommand{\DruhyNadpis}{\fontsize{15}{18}\selectfont}
\newcommand{\TretiNadpis}{\fontsize{12}{15}\selectfont}

% Kapitoly číslované — [hang] se zarovnáním na 21.55pt dle DOCX (Nadpis1 indent-left/hanging)
\titleformat{\chapter}[hang]
  {\headingfont\PrvniNadpis\bfseries}
  {\makebox[21.55pt][l]{\thechapter}}
  {0pt}{}
% Kapitoly nečíslované — bez odsazení (styl Nzev/Title v DOCX)
\titleformat{name=\chapter,numberless}[block]
  {\headingfont\PrvniNadpis\bfseries}
  {}
  {0pt}{}
% Nadpis 1 v DOCX: 18 pt před (na začátku stránky ho Word vynechá), 6 pt za.
% Hodnoty níže jsou kalibrované proti exportu z Wordu — LaTeX počítá výšku řádku
% nadpisu jinak (\topskip, \linespread), takže 0 / 6 pt by nadpis posunuly níž.
\newlength{\nadpisNahore}
\setlength{\nadpisNahore}{-24.5pt}  % −24,5 = −\topskip (11 pt) − 13,5 pt
\titlespacing*{\chapter}{0pt}{\nadpisNahore}{3.4pt}
% Na první stránce nového oddílu (Obsah, Seznam obrázků, Úvod, Přílohy) Word mezeru
% před nadpisem nevynechá → nadpis je o ~10,5 pt níž. Použití: \nadpisOddilu{Úvod}
\newcommand{\nadpisOddilu}[1]{%
  \setlength{\nadpisNahore}{-14pt}\chapter*{#1}\setlength{\nadpisNahore}{-24.5pt}}

% Podkapitoly číslované — [hang] se zarovnáním na 28.9pt dle DOCX (Nadpis2 indent-left/hanging)
\titleformat{\section}[hang]
  {\headingfont\DruhyNadpis\bfseries}
  {\makebox[28.9pt][l]{\thesection}}
  {0pt}{}
% Podkapitoly nečíslované
\titleformat{name=\section,numberless}[block]
  {\headingfont\DruhyNadpis\bfseries}
  {}
  {0pt}{}
% Nadpis 2 v DOCX: 18 pt před, 6 pt za (kalibrováno proti exportu z Wordu)
\titlespacing*{\section}{0pt}{10.5pt}{2pt}

% Oddíly (Nadpis3) — text od 36 pt jako ve víceúrovňovém číslování DOCX (NA3-F02)
\titleformat{\subsection}[hang]
  {\headingfont\TretiNadpis\bfseries}
  {\makebox[36pt][l]{\thesubsection}}{0pt}{}
% Nadpis 3 v DOCX: 18 pt před, 6 pt za (kalibrováno proti exportu z Wordu)
\titlespacing*{\subsection}{0pt}{11.2pt}{0.2pt}

% Nadpis stylu "Nzev" — 18pt tučně, 18pt před, 6pt po, BEZ zalomení stránky
% Používá se pro Klíčová slova, Abstract, Keywords uvnitř stránky Abstraktu
% (v DOCX 18 pt před a 6 pt za; hodnoty kalibrované proti exportu z Wordu)
\newcommand{\nzev}[1]{%
  \par\vspace{8.8pt}%
  {\headingfont\PrvniNadpis\bfseries #1\par}%
  \vspace{3pt}%
}

% Řádek seznamu zkratek — v DOCX odstavec s předsazením 2,5 cm (1418 twips),
% tabulátorem a mezerou 8 pt za odstavcem. Použití: \zkratka{ČR}{Česká republika}
\newcommand{\zkratka}[2]{%
  \par{\setlength{\parskip}{8pt}\hangindent=70.9pt\hangafter=1
  \noindent\makebox[70.9pt][l]{#1}#2\par}}

% Typografie dle „Jak psát práce na VŠPJ“ (kap. 1.3 a 4.5)
\clubpenalty=10000          % žádní sirotci (osamocený první řádek odstavce dole na stránce)
\widowpenalty=10000         % žádné vdovy (osamocený poslední řádek odstavce nahoře na stránce)
\displaywidowpenalty=10000
\finalhyphendemerits=10000000 % nedělit poslední slovo odstavce (DOK-F10)
\tolerance=1000           % … i za cenu volnějšího řádku (při 200 nemá TeX jinou volbu)
\brokenpenalty=10000        % nedělit slovo přes konec stránky
% Minimální počet písmen před/za rozdělovníkem (ne „t-elefon“, ne „telef-on“).
% Musí jít přes babel — ten při \begin{document} přepíše \lefthyphenmin/\righthyphenmin.
% Hodnota 23 (2 před, 3 za) je zároveň výchozí pro češtinu; uvedeno výslovně,
% aby bylo pravidlo VŠPJ vidět a dalo se případně zpřísnit.
\renewcommand{\czechhyphenmins}{23}

\renewcommand{\headrulewidth}{0pt}
% \chapter a \chapter* vynucují styl „plain“ — ať vypadá stejně jako „fancy“
\fancypagestyle{plain}{}

\usepackage{caption}
\DeclareCaptionFont{smallbf}{\small\bfseries}
\captionsetup{labelsep=colon, font=smallbf, skip=6pt}
% Mezery titulků dle Word PDF: pod obrázkem ≈ 10,6 pt od spodní hrany obrázku
% k titulku (OBR-F05), nad tabulkou titulek těsně nad horní linkou (TAB-F08)
\captionsetup[figure]{skip=10pt}
\captionsetup[table]{position=top, skip=1pt}

\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}  % rovnice (1), (2)… jako ve Wordu, ne (2.1)
% babel při \begin{document} nastaví „Obrázek“/„Tabulka“ — přepsat přes \captionsczech
\addto\captionsczech{%
  \renewcommand{\lstlistingname}{Výpis}%  % místo anglického „Listing“
  \renewcommand{\figurename}{Obr.}%
  \renewcommand{\tablename}{Tab.}%
}

\DeclareQuoteStyle{czech}{„}{"}{‚}{'}
